{
  "name": "project-launcher-agent-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Windows 桌面项目启动器 + 多 Agent 对话记录管理器（本地优先）",
  "main": "./out/main/index.js",
  "author": "woluoleiqingxvlingsui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/woluoleiqingxvlingsui/agent-vault.git"
  },
  "bugs": {
    "url": "https://github.com/woluoleiqingxvlingsui/agent-vault/issues"
  },
  "homepage": "https://github.com/woluoleiqingxvlingsui/agent-vault#readme",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack:nsis": "npm run build && electron-builder --win nsis",
    "pack:portable": "npm run build && electron-builder --win portable",
    "release": "npm run verify && npm run build && electron-builder --win nsis portable",
    "make:demo": "vite-node scripts/make-demo-data.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
